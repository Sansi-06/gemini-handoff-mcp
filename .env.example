# Server network settings
PORT=8787
HOST=127.0.0.1
# Optional canonical HTTPS base URL (e.g. https://mcp.example.com). Leave empty to infer from Host/X-Forwarded-* headers.
PUBLIC_BASE_URL=

# Storage directories
DATA_DIR=./data
# FILES_ROOT=
# NOTES_ROOT=
# REPOS_ROOT=

# Security secrets (run `node cli/handoff-cli.mjs init-env` to auto-generate)
OWNER_PASSPHRASE=
ADMIN_TOKEN=

# Optional static OAuth client credentials (if not using Dynamic Client Registration)
STATIC_OAUTH_CLIENT_ID=
STATIC_OAUTH_CLIENT_SECRET=
# Comma-separated extra allowed redirect URIs for static or custom clients
ALLOWED_REDIRECT_URIS=

# CLI target URL when running remote commands from Antigravity
BRIDGE_URL=http://127.0.0.1:8787

# Optional security hardening & tenant isolation settings
# Isolate /api/tasks and /api/sync to a separate loopback-only admin port (e.g. 8788; set BRIDGE_URL=http://127.0.0.1:8788)
# ADMIN_PORT=8788
# ADMIN_HOST=127.0.0.1
# Isolate named account files/snapshots/tasks (default: true)
TENANT_ISOLATION=true
# Comma-separated browser Origin allowlist for CORS & DNS-rebinding protection (e.g. https://gemini.google.com)
ALLOWED_ORIGINS=https://gemini.google.com
# Session lifecycle guardrails (ms / count)
# MCP_SESSION_TTL_MS=1200000
# MCP_ZERO_CALL_SESSION_TTL_MS=300000
# MCP_MAX_SESSIONS=256
